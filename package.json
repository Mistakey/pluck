{
  "name": "pluck",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "verify:ui": "pnpm build && cargo build --example pluckctl --manifest-path src-tauri/Cargo.toml && node scripts/verify-ui.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "verify:updates": "cargo build --example updates_probe --manifest-path src-tauri/Cargo.toml && node scripts/verify-updates.mjs",
    "tauri": "tauri",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "mock-cpa": "node scripts/mock-cpa.mjs",
    "verify:cli": "node scripts/verify-cli.mjs",
    "measure:resources": "node scripts/measure-resources.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@xterm/headless": "^6.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
